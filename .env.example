# Randevu talebinin gideceği adres. Tanımlı değilken form yine çalışır ama
# talep hiçbir yere gitmez; kullanıcıya WhatsApp bağlantısı gösterilir.
# Seçenekler ve kurulum: docs/randevu-gonderimi.md
VITE_APPOINTMENT_ENDPOINT=""

# Form servisinin (ör. Web3Forms) anahtarı. Doktorun kendi e-posta adresiyle
# açtığı hesaptan alınır; talepler o adrese düşer.
VITE_APPOINTMENT_KEY=""

# Yönetim paneli (Supabase). Doktorun kendi Supabase projesinden:
# Project Settings → API → "Project URL" ve "anon public" anahtar.
# service_role / secret anahtarı ASLA buraya yazılmaz.
# Kurulum: docs/yonetim-paneli.md
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
